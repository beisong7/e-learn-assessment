NODE_ENV=development
HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Required at API startup. Create these databases and set your local password.
DATABASE_URL=postgresql://learnova_app:replace_with_local_password@127.0.0.1:5432/learnova_dev?schema=public
# Used only by db:migrate:test / test:db; must be a separate database ending in _test.
TEST_DATABASE_URL=postgresql://learnova_app:replace_with_local_password@127.0.0.1:5432/learnova_test?schema=public
# Used by Prisma migrate dev to replay migrations; contains no application data.
SHADOW_DATABASE_URL=postgresql://learnova_app:replace_with_local_password@127.0.0.1:5432/learnova_shadow?schema=public


# Optional: required only by npm run db:seed. Set the chosen shared demo password.
SEED_DEMO_PASSWORD=

# Absolute session lifetime; authentication uses opaque database-backed tokens.
SESSION_TTL_HOURS=24
