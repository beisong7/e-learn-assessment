{
  "name": "learnova-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/database.test.ts --exclude '**/*.db.test.ts'",
    "format": "prettier --write src tests scripts *.json",
    "format:check": "prettier --check src tests scripts *.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:check": "tsx scripts/check-database.ts",
    "db:migrate:test": "tsx scripts/test-database.ts migrate",
    "test:db": "tsx scripts/test-database.ts test",
    "postinstall": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "e2e:server": "tsx scripts/e2e-server.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "vitest": "^3.2.0"
  }
}
