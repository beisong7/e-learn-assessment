generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  LEARNER
  ADMIN
}

enum CourseCategory {
  DESIGN
  DEVELOPMENT
  DATA_SCIENCE
  BUSINESS
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ALL_LEVELS
}

model User {
  isActive     Boolean      @default(true) @map("is_active")
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(120)
  email        String       @unique @db.VarChar(320)
  passwordHash String       @map("password_hash") @db.Text
  role         UserRole     @default(LEARNER)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollments  Enrollment[]
  sessions     Session[]

  @@map("users")
}

model Course {
  version        Int            @default(1)
  id             String         @id @default(uuid()) @db.Uuid
  title          String         @db.VarChar(140)
  description    String         @db.Text
  category       CourseCategory
  thumbnailUrl   String         @map("thumbnail_url") @db.Text
  instructorName String         @map("instructor_name") @db.VarChar(120)
  level          CourseLevel    @default(BEGINNER)
  outcomes       String[]       @default([])
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  lessons        Lesson[]
  enrollments    Enrollment[]

  @@index([category])
  @@map("courses")
}

model Lesson {
  id              String           @id @default(uuid()) @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  title           String           @db.VarChar(140)
  videoUrl        String           @map("video_url") @db.Text
  durationSeconds Int              @map("duration_seconds")
  order           Int              @map("position")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  progress        LessonProgress[]

  // The compound key lets progress enforce that its lesson belongs to its enrollment's course.
  @@unique([id, courseId])
  @@unique([courseId, order])
  @@map("lessons")
}

model Enrollment {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  courseId   String           @map("course_id") @db.Uuid
  enrolledAt DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  progress   LessonProgress[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  userId          String     @map("user_id") @db.Uuid
  lessonId        String     @map("lesson_id") @db.Uuid
  courseId        String     @map("course_id") @db.Uuid
  positionSeconds Float      @default(0) @map("position_seconds") @db.DoublePrecision
  completed       Boolean    @default(false)
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment      Enrollment @relation(fields: [userId, courseId], references: [userId, courseId], onDelete: Cascade, onUpdate: Cascade)
  lesson          Lesson     @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, lessonId])
  @@index([userId, courseId])
  @@index([lessonId, courseId])
  @@map("lesson_progress")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
